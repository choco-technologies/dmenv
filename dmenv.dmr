# DMOD Resource File for dmenv
# This file specifies where resources should be installed
# Note: dmenv is a built-in module, so no .dmf file is distributed

# === Header Files ===
# Include directory with dmenv.h header
inc=./include => ${destination}/${module}/include [origin=${repo_dir}/include]

# === Static Library ===
# Precompiled static library (architecture-specific build)
lib=./lib/libdmenv.a => ${destination}/${module}/lib/libdmenv.a [origin=${build_dir}/libdmenv.a]

# === Documentation ===
# README file
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/README.md]

# === License ===
# License file
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./dmenv.dmr => ${destination}/${module}/dmenv.dmr [origin=${repo_dir}/dmenv.dmr]
